# Procore OAuth credentials (from Procore Developer Portal)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# Default company ID (integer) — used as Procore-Company-Id header
PROCORE_COMPANY_ID=

# Procore environment: production (default) or sandbox
PROCORE_ENV=production

# Tool mode: meta (default, 7 compact tools) or all (one tool per endpoint)
PROCORE_TOOL_MODE=meta

# Optional API request timeout in milliseconds (default: 30000, max: 300000)
# PROCORE_REQUEST_TIMEOUT_MS=30000

# Optional OAuth token exchange/refresh timeout (default: 30000, max: 300000)
# PROCORE_AUTH_TIMEOUT_MS=30000

# Optional absolute token storage path (default: ~/.procore-mcp/tokens.json)
# PROCORE_TOKEN_PATH=

# Read-only mode (default: true). While on, only GET requests are served and
# write endpoints are hidden from the catalog. Set to false to allow writes.
PROCORE_READ_ONLY=true

# ---------------------------------------------------------------------------
# Hosted mode (`npm run start:http`) — stateless Streamable HTTP + per-user
# OAuth so each user signs in to Procore with their own account.
# ---------------------------------------------------------------------------

# Public base URL of the hosted server (no trailing slash). Must be HTTPS in
# production; ChatGPT connectors require it.
# PROCORE_MCP_BASE_URL=https://procore-mcp.example.com

# Secret used to sign MCP access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tokens stop working after a restart if this is unset (ephemeral key).
# PROCORE_MCP_TOKEN_SECRET=

# Access-token lifetime in seconds (default: 30 days).
# PROCORE_MCP_ACCESS_TOKEN_TTL=2592000

# Comma-separated allowlist of OAuth redirect URIs that MCP clients may use
# during sign-in. Required for /oauth/authorize unless you set the dev-only
# PROCORE_ALLOW_ANY_REDIRECT=true (accepts any https URI).
# PROCORE_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

# Directory for per-user Procore token files (default: ~/.procore-mcp/users).
# Swap src/auth/user-token-store.ts for S3/DynamoDB when running multiple
# instances or ephemeral/serverless filesystems.
# PROCORE_USER_TOKEN_DIR=

# Listen port for the HTTP server (default: 8787)
# PORT=8787

# Maximum OAuth request-body size in bytes (default: 65536).
# PROCORE_MCP_MAX_BODY_BYTES=65536

# Maximum time to receive an OAuth request body in milliseconds (default: 10000).
# PROCORE_MCP_BODY_TIMEOUT_MS=10000
