# Procore OAuth credentials (from Procore Developer Portal)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# Default company ID (integer) — used as Procore-Company-Id header
PROCORE_COMPANY_ID=

# Procore environment: production (default) or sandbox
PROCORE_ENV=production

# Tool mode: meta (default, 7 compact tools) or all (one tool per endpoint)
PROCORE_TOOL_MODE=meta

# Optional API request timeout in milliseconds (default: 30000, max: 300000)
# PROCORE_REQUEST_TIMEOUT_MS=30000

# Optional OAuth token exchange/refresh timeout (default: 30000, max: 300000)
# PROCORE_AUTH_TIMEOUT_MS=30000

# Optional absolute token storage path (default: ~/.procore-mcp/tokens.json)
# PROCORE_TOKEN_PATH=

# Read-only mode (default: true). While on, only GET requests are served and
# write endpoints are hidden from the catalog. Set to false to allow writes.
PROCORE_READ_ONLY=true
