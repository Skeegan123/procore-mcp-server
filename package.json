{
  "name": "procore-mcp-server",
  "version": "2.0.0",
  "description": "MCP server exposing the Procore REST API to Codex and other MCP clients",
  "author": "Tyler Ilunga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TylerIlunga/procore-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "procore",
    "claude",
    "model-context-protocol",
    "construction",
    "api"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node --import tsx scripts/generate-catalog.ts && node --import tsx scripts/generate-tools-manifest.ts",
    "validate": "node --import tsx scripts/validate-catalog.ts",
    "build": "npm run validate && tsc",
    "build:from-oas": "npm run generate && npm run build",
    "test": "npm run test:manifest && npm run test:unit",
    "test:manifest": "node --import tsx scripts/verify-manifest.ts",
    "test:unit": "node --import tsx --test test/*.test.ts tests/*.test.ts",
    "start": "node dist/src/index.js",
    "auth": "node --import tsx src/auth/setup.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
